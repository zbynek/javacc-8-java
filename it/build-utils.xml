<!-- 
  Some utility ant targets to be called from maven.
  Feb 2025. Authors: Maͫzͣaͬsͨ
-->
<project name="build-utils" basedir="../..">

  <!-- compares output file (.out) to expected one (.exp_out)
     param1: dir: the directory where the files directory lies
     param2: file: the name of the test file (without extension) -->
  <target name="compare-out">
    <available file="${dir}/files/${file}.out" property="isActualOutAvailable" />
    <fail unless="isActualOutAvailable" message="${dir}/files/${file}.out does not exist!" />
    <available file="${dir}/files/${file}.exp_out" property="isExpectedOutAvailable" />
    <fail unless="isExpectedOutAvailable" message="${dir}/files/${file}.exp_out does not exist!" />
    <!-- need to get rid of the project's base directory string in the out file -->
    <copy file="${dir}/files/${file}.out" tofile="${dir}/files/${file}2.out" />
    <replace file="${dir}/files/${file}2.out">
      <replacetoken expandProperties="true">${dir}</replacetoken>
      <!-- expand set to false does not seem to work, so using an unknown property -->
      <replacevalue expandProperties="false">${project-basedir}</replacevalue>
    </replace>
    <condition property="out.files.match">
      <filesmatch textfile="true"
                  file1="${dir}/files/${file}2.out"
                  file2="${dir}/files/${file}.exp_out"
      />
    </condition>
    <fail unless="out.files.match"
          message="${dir}/files/${file}2.out does not match ${dir}/files/${file}.exp_out!"
    />
    <echo message="Output file ${dir}/files/${file}.out is the one expected :)" level="info" />
  </target>

  <!-- compares error file (.err) to expected one (.exp_err)
     param1: dir: the directory where the files directory lies
     param2: file: the name of the test file (without extension) -->
  <target name="compare-err">
    <available file="${dir}/files/${file}.err" property="isActualErrAvailable" />
    <fail unless="isActualErrAvailable" message="${dir}/files/${file}.err does not exist!" />
    <available file="${dir}/files/${file}.exp_err" property="isExpectedErrAvailable" />
    <fail unless="isActualErrAvailable" message="${dir}/files/${file}.exp_err does not exist!" />
    <!-- need to get rid of the project's base directory string in the err file -->
    <copy file="${dir}/files/${file}.err" tofile="${dir}/files/${file}2.err" />
    <replace file="${dir}/files/${file}2.err">
      <replacetoken expandProperties="true">${dir}</replacetoken>
      <!-- expand set to false does not seem to work, so using an unknown property -->
      <replacevalue expandProperties="false">${project-basedir}</replacevalue>
    </replace>
    <condition property="err.files.match">
      <filesmatch textfile="true"
                  file1="${dir}/files/${file}2.err"
                  file2="${dir}/files/${file}.exp_err"
      />
    </condition>
    <fail unless="err.files.match"
          message="${dir}/files/${file}2.err does not match ${dir}/files/${file}.exp_err!"
    />
    <echo message="Error file {dir}/files/${file}.err is the one expected :)" level="info" />
  </target>

</project>